# ==========================================
# vCenter Authentication Credentials
# ==========================================
vsphere_user     = "administrator@vsphere.local"
vsphere_password = "<supervisor-admin-password>"
vsphere_server   = "<vcenter IP/FQDN>"

# ==========================================
# Namespace Configuration Variables
#
# from vCenter run command to get supervisor_id
# dcli com vmware vcenter namespacemanagement supervisors summary list
#
# ==========================================
namespace_name     = "example-namespace"
supervisor_id      = "828af6bc-d998-4f2c-85ee-f98dda19eb47"
#content_library_id = "ca616f93-506d-4f00-98bf-7708d30f68bc"

# Multiple VM Classes
vm_classes = [
  "best-effort-small",
  "best-effort-medium",
  "best-effort-large",
  "guaranteed-small"
]

# Storage Policies
storage_policy_ids = [
  "aa6d5a82-1c88-45da-85d3-3d74b91a5bad"
]
